[Unit]
Description=Restore the pinned supervisor session in Orca
After=orca-serve.service
Wants=orca-serve.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ORCH_ORCA=%h/.local/bin/orca
Environment=ORCH_HOME=%h/orchestration-kit
Environment=ORCH_CLAUDE_CONFIG_DIR=%h/.config/orchestrator-claude
EnvironmentFile=-%h/.config/orchestration-kit/environment
ExecStart=%h/orchestration-kit/examples/orch-start-orchestrator
TimeoutStartSec=660

[Install]
WantedBy=default.target
