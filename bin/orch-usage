#!/usr/bin/env python3
"""Bounded account usage summary, without account identities or subscription labels."""
import json
import os
import subprocess
import sys


def line(label, limits):
    if not limits:
        return
    parts = []
    for key, window in limits.items():
        if isinstance(window, dict) and 'usedPercent' in window:
            reset = window.get('resetDescription', '')
            parts.append(f'{key}={window["usedPercent"]}% resets {reset}')
    extra = limits.get('extraUsage') or {}
    if extra.get('balance') is not None:
        parts.append(f'credits={extra["balance"]:.0f}')
    if parts:
        print(f'{label}: ' + '; '.join(parts))


try:
    result = subprocess.run([os.getenv('ORCH_ORCA', 'orca'), 'account', 'list', '--json'],
                            capture_output=True, text=True, check=True, timeout=30)
    data = json.loads(result.stdout)['result']['rateLimits']
    for i, account in enumerate(data.get('inactiveClaudeAccounts', []), 1):
        line(f'Claude pool {i}', account.get('rateLimits', {}))
    line('active Claude', data.get('claude'))
    line('Codex', data.get('codex'))
except (OSError, subprocess.SubprocessError, ValueError, KeyError) as exc:
    print(f'usage unavailable ({type(exc).__name__})', file=sys.stderr)
    sys.exit(1)
